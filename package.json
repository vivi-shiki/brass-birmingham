{
  "name": "brass-birmingham-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "verify": "npm run build && npm test -- --reporter=dot && npm run face-audit:release-gate && npm run face-audit:ci-artifacts-self-check && npm run face-audit:review-kit-self-check",
    "start": "tsx src/server/index.ts",
    "face-audit:checklist": "tsx src/tools/faceAuditCli.ts checklist",
    "face-audit:template": "tsx src/tools/faceAuditCli.ts template",
    "face-audit:area-template": "tsx src/tools/faceAuditCli.ts area-template",
    "face-audit:template-with-sources": "tsx src/tools/faceAuditCli.ts template-with-sources",
    "face-audit:area-template-with-sources": "tsx src/tools/faceAuditCli.ts area-template-with-sources",
    "face-audit:merge": "tsx src/tools/faceAuditCli.ts merge",
    "face-audit:status": "tsx src/tools/faceAuditCli.ts status",
    "face-audit:todo": "tsx src/tools/faceAuditCli.ts todo",
    "face-audit:review-plan": "tsx src/tools/faceAuditCli.ts review-plan",
    "face-audit:review-sheet": "tsx src/tools/faceAuditCli.ts review-sheet",
    "face-audit:area-review-sheet": "tsx src/tools/faceAuditCli.ts area-review-sheet",
    "face-audit:apply-review-sheet": "tsx src/tools/faceAuditCli.ts apply-review-sheet",
    "face-audit:reviewer-instructions": "tsx src/tools/faceAuditCli.ts reviewer-instructions",
    "face-audit:area-reviewer-instructions": "tsx src/tools/faceAuditCli.ts area-reviewer-instructions",
    "face-audit:ci-artifacts": "tsx src/tools/faceAuditCli.ts ci-artifacts",
    "face-audit:verify-ci-artifacts": "tsx src/tools/faceAuditCli.ts verify-ci-artifacts",
    "face-audit:ci-artifacts-self-check": "tsx src/tools/faceAuditCli.ts ci-artifacts-self-check",
    "face-audit:review-kit": "tsx src/tools/faceAuditCli.ts review-kit",
    "face-audit:verify-review-kit": "tsx src/tools/faceAuditCli.ts verify-review-kit",
    "face-audit:review-kit-self-check": "tsx src/tools/faceAuditCli.ts review-kit-self-check",
    "face-audit:handoff": "tsx src/tools/faceAuditCli.ts handoff",
    "face-audit:verify-handoff": "tsx src/tools/faceAuditCli.ts verify-handoff",
    "face-audit:handoff-response": "tsx src/tools/faceAuditCli.ts handoff-response",
    "face-audit:validate": "tsx src/tools/faceAuditCli.ts validate",
    "face-audit:ready": "tsx src/tools/faceAuditCli.ts ready",
    "face-audit:lock-preview": "tsx src/tools/faceAuditCli.ts lock-preview",
    "face-audit:lock-artifact": "tsx src/tools/faceAuditCli.ts lock-artifact",
    "face-audit:verify-lock-artifact": "tsx src/tools/faceAuditCli.ts verify-lock-artifact",
    "face-audit:release-gate": "tsx src/tools/faceAuditCli.ts release-gate",
    "face-audit:hash-source": "tsx src/tools/faceAuditCli.ts hash-source",
    "face-audit:source-template": "tsx src/tools/faceAuditCli.ts source-template",
    "face-audit:source-ids-by-area-template": "tsx src/tools/faceAuditCli.ts source-ids-by-area-template",
    "face-audit:evidence-ref-template": "tsx src/tools/faceAuditCli.ts evidence-ref-template",
    "face-audit:area-match-template": "tsx src/tools/faceAuditCli.ts area-match-template",
    "face-audit:review-match-template": "tsx src/tools/faceAuditCli.ts review-match-template",
    "face-audit:review-match-template-by-area": "tsx src/tools/faceAuditCli.ts review-match-template-by-area",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
